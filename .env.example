# Copy to .env.local for development. Never commit real keys.
# .env.local is gitignored.

# Fitbit-via-Google-Health OAuth. Can also be set per-device in Settings.
VITE_FITBIT_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# USDA FoodData Central (optional). Free key from https://api.data.gov/signup/.
# Without it, packaged and barcode search still work via Open Food Facts, and a
# user can paste their own key in Settings. This is inlined into the client
# bundle at build time, so treat it as public (proxy via the Worker if you need
# it truly private).
VITE_USDA_API_KEY=

# App identity for Open Food Facts contributions
VITE_OFF_APP_NAME=calorie-tracker
VITE_OFF_APP_VERSION=0.0.1
