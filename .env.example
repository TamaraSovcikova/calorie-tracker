# Copy to .env.local for development. Never commit real keys.
# .env.local is gitignored.

# Fitbit-via-Google-Health OAuth. Can also be set per-device in Settings.
VITE_FITBIT_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# USDA FoodData Central. A free public key is bundled so search works out of the
# box; set this to override it with your own (from https://api.data.gov/signup/).
# Inlined into the client bundle at build time, so any key here is public.
VITE_USDA_API_KEY=

# App identity for Open Food Facts contributions
VITE_OFF_APP_NAME=calorie-tracker
VITE_OFF_APP_VERSION=0.0.1
